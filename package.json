{
  "name": "flash_learn",
  "scripts": {
    "dev": "bun run --hot src/main.ts",
    "db:gen": "bun run drizzle-kit generate",
    "db:migrate": "bun run drizzle-kit migrate",
    "db:seed": "bun run scripts/seed.ts",
    "db:dump": "bun run scripts/dump.ts",
    "db:refresh": "rm -f data.db && touch data.db && bun run db:gen && bun run db:migrate && bun run db:seed && bun run db:dump"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.4.0",
    "@hono/structured-logger": "^1.0.0",
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.11"
  }
}
